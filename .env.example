# ── Database ─────────────────────────────────────────────
# Leave both Turso lines EMPTY to use a local file (travelguide.db).
# Fill them in to use your hosted Turso database:
#   Turso dashboard → your database → copy the URL (starts with libsql://)
#   Turso dashboard → your database → create a token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# JWT secret (change this to any random string)
JWT_SECRET=your-secret-key-change-this

# OpenRouter API key (for AI recommend feature)
# Sign up at https://openrouter.ai → API Keys → Create Key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# Optional: override the free model used by /api/tours/recommend
# OPENROUTER_MODEL=

# Server port
PORT=3001
